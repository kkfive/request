{
  "name": "@kkfive/request",
  "type": "module",
  "version": "0.3.0",
  "packageManager": "pnpm@10.21.0",
  "description": "A self-used request encapsulation",
  "author": "DreamyTZK",
  "license": "MIT",
  "homepage": "https://github.com/kkfive/request#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkfive/request.git"
  },
  "bugs": "https://github.com/kkfive/request/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepublishOnly": "nr build",
    "release": "bumpp && pnpm publish",
    "start": "tsx src/index.ts",
    "start:example": "tsx examples/index.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "update:deps": "npx taze -r -w",
    "tsx": "tsx"
  },
  "peerDependencies": {
    "ky": "^1.14.0",
    "qs": "^6.14.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@antfu/ni": "catalog:",
    "@antfu/utils": "catalog:",
    "@esdora/kit": "catalog:",
    "@types/node": "catalog:",
    "@types/qs": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "ky": "catalog:",
    "lint-staged": "catalog:",
    "qs": "catalog:",
    "simple-git-hooks": "catalog:",
    "tinyexec": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-package-exports": "catalog:",
    "yaml": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,mts,mjs,cts,cjs}": "eslint --fix"
  }
}

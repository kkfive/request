{
  "name": "@kkfive/request",
  "type": "module",
  "version": "0.6.0",
  "packageManager": "pnpm@11.5.0",
  "description": "Lightweight business-layer HTTP client built on ky: token injection, 401 auto-refresh, response parsing, BusinessError, and SSE",
  "author": "DreamyTZK",
  "license": "MIT",
  "homepage": "https://github.com/kkfive/request#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkfive/request.git"
  },
  "bugs": "https://github.com/kkfive/request/issues",
  "keywords": [
    "http",
    "http-client",
    "request",
    "fetch",
    "ky",
    "token-refresh",
    "sse",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "examples",
    "llms.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepublishOnly": "pnpm verify",
    "changelog": "changelogen --output CHANGELOG.md",
    "release:prepare": "bumpp --execute \"pnpm changelog\"",
    "start": "tsx src/index.ts",
    "start:example": "tsx examples/index.ts",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:pack": "tsx scripts/test-pack.ts",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:coverage && pnpm build && pnpm test:pack",
    "prepare": "simple-git-hooks",
    "update:deps": "npx taze -r -w"
  },
  "dependencies": {
    "ky": "catalog:",
    "parse-sse": "catalog:",
    "qs": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@antfu/utils": "catalog:inlined",
    "@types/node": "catalog:types",
    "@types/qs": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bumpp": "catalog:cli",
    "changelogen": "catalog:cli",
    "eslint": "catalog:cli",
    "lint-staged": "catalog:cli",
    "publint": "catalog:",
    "simple-git-hooks": "catalog:cli",
    "tinyexec": "catalog:utils",
    "tsdown": "catalog:",
    "tsdown-stale-guard": "catalog:",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing",
    "vitest-package-exports": "catalog:testing",
    "yaml": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
